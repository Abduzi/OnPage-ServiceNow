<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description>With the addition of the "Send When" field, we need to update all subscription records with an empty "Send When" field to the default 'Both'.</description>
        <name>Update OnPage Send When field if empty</name>
        <record_for_rollback>false</record_for_rollback>
        <script><![CDATA[var subs = new GlideRecord('x_onpr_onpage_onpage_subscription');
subs.addQuery('send_when=NULL');
subs.query();
while(subs.next()){
	subs.send_when = 'both';
	subs.update();
}]]></script>
        <sys_class_name>sys_script_fix</sys_class_name>
        <sys_created_by>toan.tran</sys_created_by>
